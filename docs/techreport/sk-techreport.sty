%%──────────────────────────────────────────────────────────────────
%% Revision History mechanism
%%──────────────────────────────────────────────────────────────────

\newenvironment{revisionhistory}{%
  \begin{center}
    \small
    \begin{tabular}{ll p{0.6\linewidth}}
    \toprule
    \textbf{Version} & \textbf{Date} & \textbf{Changes} \\
    \midrule
}{%
    \bottomrule
    \end{tabular}
  \end{center}
}

%%──────────────────────────────────────────────────────────────────
%% Title page — \maketechreporttitle{key=value, ...}
%%──────────────────────────────────────────────────────────────────

% Key definitions
\newcommand{\sk@title}{}
\newcommand{\sk@subtitle}{}
\newcommand{\sk@reportid}{}
\newcommand{\sk@version}{}
\newcommand{\sk@date}{}
\newcommand{\sk@author}{}
\newcommand{\sk@affiliation}{}
\newcommand{\sk@abstract}{}
\newcommand{\sk@revisions}{}
\newcommand{\sk@versiontable}{}
\newcommand{\sk@coverimage}{}
\newcommand{\sk@classification}{RESEARCH}

\define@key{sktitle}{title}{\renewcommand{\sk@title}{#1}}
\define@key{sktitle}{subtitle}{\renewcommand{\sk@subtitle}{#1}}
\define@key{sktitle}{reportid}{\renewcommand{\sk@reportid}{#1}}
\define@key{sktitle}{version}{\renewcommand{\sk@version}{#1}}
\define@key{sktitle}{date}{\renewcommand{\sk@date}{#1}}
\define@key{sktitle}{author}{\renewcommand{\sk@author}{#1}}
\define@key{sktitle}{affiliation}{\renewcommand{\sk@affiliation}{#1}}
\define@key{sktitle}{abstract}{\renewcommand{\sk@abstract}{#1}}
\define@key{sktitle}{revisions}{\renewcommand{\sk@revisions}{#1}}
\define@key{sktitle}{versiontable}{\renewcommand{\sk@versiontable}{#1}}
\define@key{sktitle}{coverimage}{\renewcommand{\sk@coverimage}{#1}}
\define@key{sktitle}{classification}{\renewcommand{\sk@classification}{#1}}

\newcommand{\maketechreporttitle}[1]{%
  \begingroup
  \setkeys{sktitle}{#1}%
  % Populate header fields and PDF metadata
  \global\let\sk@saved@revisions\sk@revisions
  \global\let\sk@saved@versiontable\sk@versiontable
  \renewcommand{\sk@rptitle}{\sk@title}%
  \renewcommand{\sk@rpid}{\sk@reportid}%
  \hypersetup{pdftitle={\sk@title}, pdfauthor={\sk@author}, pdfsubject={\sk@reportid}}%
  %
  % Use Alph numbering for titlepage to avoid page.1 duplicate with arabic body
  \pagenumbering{Alph}%
  \begin{titlepage}
    \thispagestyle{empty}%
    %
    % ── Accent band with report ID & Classification ──
    \noindent\begin{tcolorbox}[
      colback=skAccent, colframe=skAccent,
      boxrule=0pt,
      arc=0pt,
      left=8pt, right=8pt,
      top=6pt, bottom=6pt,
      enlarge left by=-\dimexpr\oddsidemargin+1in\relax,
      width=\paperwidth,
      fontupper=\color{white},
    ]
      {\small\bfseries\sk@classification}\hfill{\large\bfseries\sk@reportid}%
    \end{tcolorbox}%
    %
    \vspace{1.0cm}%
    %
    % ── Title ──
    {\Huge\bfseries\color{skAccent}\sk@title\par}%
    %
    % ── Subtitle (optional) ──
    \ifx\sk@subtitle\empty\else
      \vspace{0.3cm}%
      {\Large\color{skAccent!80!black}\sk@subtitle\par}%
    \fi
    %
    \vspace{0.6cm}%
    %
    % ── Accent rule ──
    {\color{skAccent}\rule{0.6\linewidth}{0.6pt}}\par
    %
    \vspace{0.8cm}%
    %
    % ── Author / affiliation / date ──
    {\large\sk@author\par}%
    \ifx\sk@affiliation\empty\else
      \vspace{0.15cm}%
      {\normalsize\sk@affiliation\par}%
    \fi
    \vspace{0.3cm}%
    {\normalsize\sk@date%
      \ifx\sk@version\empty\else
        \enspace$\bullet$\enspace Version \sk@version%
      \fi
    \par}%
    \vspace{0.15cm}%
    {\small\color{black!60}Last updated: \today\par}%
    %
    % ── Cover Image (optional) ──
    \ifx\sk@coverimage\empty\else
      \vspace{1.0cm}
      \begin{center}
        \adjustbox{max width=\linewidth}{\sk@coverimage}
      \end{center}
    \fi
    %
    \vspace{1.2cm}%
    %
    % ── Abstract ──
    \ifx\sk@abstract\empty\else
      \begin{center}
      \begin{tcolorbox}[
        enhanced,
        colback=skAccent!8,
        colframe=white,
        borderline west={3pt}{0pt}{skAccent},
        width=0.85\linewidth,
        arc=0pt,
        left=8pt, right=8pt, top=6pt, bottom=6pt,
      ]
        \textbf{Abstract.}\enspace\sk@abstract
      \end{tcolorbox}
      \end{center}
    \fi
    %
  \end{titlepage}
  %
  % Apply page style and generate ToC
  \pagestyle{skreport}%
  \pagenumbering{roman}%
  \tableofcontents
  \vspace{1em}
  \pagenumbering{arabic}%
  \endgroup
}


%%──────────────────────────────────────────────────────────────────
%% Revision History — place in back matter
%%──────────────────────────────────────────────────────────────────

\newcommand{\printrevisionhistory}{%
  \ifx\sk@saved@versiontable\empty
    \ifx\sk@saved@revisions\empty\else
      \phantomsection
      \addcontentsline{toc}{section}{Revision History}%
      \section*{Revision History}%
      \begin{revisionhistory}
        \sk@saved@revisions
      \end{revisionhistory}
    \fi
  \else
    \phantomsection
    \addcontentsline{toc}{section}{Revision History}%
    \section*{Revision History}%
    \begin{center}
      \small
      \sk@saved@versiontable
    \end{center}
  \fi
}

%%──────────────────────────────────────────────────────────────────
%% Todo List — place in back matter (draft mode only)
%%──────────────────────────────────────────────────────────────────

\newcommand{\printtodolist}{%
  \ifsk@draft
    \phantomsection
    \addcontentsline{toc}{section}{Todo List}%
    \listoftodos
  \fi
}

\endinput
