%% sk-techreport.sty — Tech report preamble with Libertinus fonts
%%
%% Usage:
%%   \documentclass[a4paper,10pt]{article}
%%   \usepackage{sk-techreport}
%%   \maketechreporttitle{title={...}, reportid={...}, ...}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sk-techreport}[2026/03/11 SK tech report preamble - v2.5]

%%──────────────────────────────────────────────────────────────────
%% Options
%%──────────────────────────────────────────────────────────────────

\newif\ifsk@draft\sk@draftfalse
\newif\ifsk@minted\sk@mintedfalse
\DeclareOption{draft}{\sk@drafttrue}
\DeclareOption{final}{\sk@draftfalse}
\DeclareOption{minted}{\sk@mintedtrue}
\ProcessOptions\relax

%%──────────────────────────────────────────────────────────────────
%% Page geometry
%%──────────────────────────────────────────────────────────────────

\RequirePackage[
  a4paper,
  top=2cm, bottom=2cm,
  left=2cm, right=3.5cm,
  marginparwidth=2.8cm, marginparsep=0.4cm,
  headheight=22pt,
]{geometry}
\RequirePackage[parfill]{parskip}
\setlength{\parskip}{0.4em plus 0.1em minus 0.05em}

% Widow/orphan control
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

%%──────────────────────────────────────────────────────────────────
%% Typography — Libertinus Serif + Fira Mono
%%──────────────────────────────────────────────────────────────────

\RequirePackage[T1]{fontenc}
\RequirePackage{libertinus}
\RequirePackage{libertinust1math}
\RequirePackage[scale=0.85]{FiraMono}
\RequirePackage[tracking=true, protrusion=true, expansion=true]{microtype}
\SetTracking{encoding=*,shape=sc}{40}

\RequirePackage{setspace}
\setstretch{1.0}

%%──────────────────────────────────────────────────────────────────
%% Packages
%%──────────────────────────────────────────────────────────────────

\RequirePackage{listings}
\RequirePackage{booktabs}
\renewcommand{\arraystretch}{1.15}   % compact row spacing
\RequirePackage{subcaption}
\RequirePackage{float}
\RequirePackage{morefloats}
\extrafloats{200}
\RequirePackage{longtable}
\RequirePackage{tabularx}
\RequirePackage{mathtools}
\RequirePackage{amssymb}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{tikz}
\RequirePackage{adjustbox}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\RequirePackage{enumitem}
\RequirePackage[most]{tcolorbox}
\RequirePackage{xspace}
\RequirePackage{xkeyval}
\RequirePackage{etoolbox}
\RequirePackage{nameref}
\RequirePackage{marginnote}
\renewcommand*{\marginfont}{\scriptsize\itshape\color{skAccent!80!black}}

%% Modern Packages for v2.2+
\RequirePackage[
  backend=biber,
  style=ieee,
  citestyle=numeric-comp,
  sorting=none,
  defernumbers=true
]{biblatex}

% Some TeX installs do not provide etoolbox's \ifnamecontains.
% Define a conservative fallback (no highlighting) before hooks use it.
\providecommand{\ifnamecontains}[4]{#4}

% Highlight own citations
% Note: \ifnamecontains is not available in all TeX installs; we define a
% fallback below and place it before this hook.
\newcommand{\myself}{Knight, Simon}
\AtEveryBibitem{%
  \ifitemannotation{star}{%
    \makebox[0pt][r]{$\star$\hspace{1em}}%
  }{}%
  \ifnamecontains{author}{\myself}{%
    \color{skAccent}%
  }{}%
}

\RequirePackage[printonlyused,withpage]{acronym}
\RequirePackage[colorinlistoftodos,prependcaption,textsize=tiny]{todonotes}

\ifsk@draft
  \RequirePackage[firstpageonly=false]{draftwatermark}
  \SetWatermarkText{DRAFT}
  \SetWatermarkScale{1.2}
  \SetWatermarkColor{gray!15}
\fi

\ifsk@minted
  \RequirePackage{minted}
  \usemintedstyle{default}
  \setminted{
    fontsize=\fontsize{8.5}{10.5}\selectfont,
    breaklines=true,
    bgcolor=skCodeBg,
    frame=leftline,
    framesep=10pt,
    rulecolor=skAccent!25,
  }
\fi

%%──────────────────────────────────────────────────────────────────
%% Ph.D. Insights & Design Rules
%%──────────────────────────────────────────────────────────────────

\newcommand{\insight}[1]{%
  \marginnote{%
    \begin{spacing}{0.8}
      \textcolor{skAccent}{\textbf{Insight:}}\\ #1
    \end{spacing}
  }%
}

\newtcolorbox[auto counter, list inside=lod]{designrule}[1][]{%
  enhanced, breakable,
  colback=skAccent!5, colframe=skAccent,
  borderline west={3pt}{0pt}{skAccent},
  fonttitle=\bfseries\small\color{white},
  coltitle=white,
  attach boxed title to top left={xshift=10pt, yshift=-10pt},
  boxed title style={colback=skAccent, arc=2pt, boxrule=0pt},
  title={\hyperlink{lod_top}{Design Rule \thetcbcounter}\ifstrempty{#1}{}{: #1}},
  left=8pt, right=8pt, top=12pt, bottom=6pt,
  arc=0pt, boxrule=0pt,
  list entry={\protect\numberline{\thetcbcounter}Design Rule\ifstrempty{#1}{}{: #1}},
}

%%──────────────────────────────────────────────────────────────────
%% Captions
%%──────────────────────────────────────────────────────────────────

\RequirePackage{ragged2e}
\RequirePackage{caption}
\captionsetup{
  font=small,
  labelfont={bf,color=skAccent},
  labelsep=period,
  justification=RaggedRight,
  skip=6pt,
}

%%──────────────────────────────────────────────────────────────────
%% URL breaking (must load before hyperref)
%%──────────────────────────────────────────────────────────────────

\RequirePackage{xurl}

%%──────────────────────────────────────────────────────────────────
%% Hyperref (load late)
%%──────────────────────────────────────────────────────────────────

\RequirePackage[
  colorlinks=true,
  linkcolor=skAccent,
  citecolor=skAccent!80!black,
  urlcolor=skAccent!70!blue,
]{hyperref}
\RequirePackage{bookmark}
\RequirePackage{cleveref}

%%──────────────────────────────────────────────────────────────────
%% Shared colours, languages, macros
%%──────────────────────────────────────────────────────────────────

\input{sk-shared.def}
\makeindex

%%──────────────────────────────────────────────────────────────────
%% List styling — accent-coloured bullets and numbers
%%──────────────────────────────────────────────────────────────────

\setlist[itemize,1]{label=\textcolor{skAccent}{\textbullet}, itemsep=1pt, parsep=0pt, topsep=3pt}
\setlist[itemize,2]{label=\textcolor{skAccent!60}{--}, itemsep=1pt, parsep=0pt}
\setlist[enumerate,1]{label=\textcolor{skAccent}{\arabic*.}, itemsep=1pt, parsep=0pt, topsep=3pt}

%%──────────────────────────────────────────────────────────────────
%% Footnote styling — shorter coloured rule, coloured markers
%%──────────────────────────────────────────────────────────────────

\renewcommand{\footnoterule}{\kern-3pt{\color{skAccent!30}\hrule width 0.25\columnwidth height 0.4pt}\kern 2.6pt}
\renewcommand{\thefootnote}{\textcolor{skAccent}{\arabic{footnote}}}

%%──────────────────────────────────────────────────────────────────
%% Listings defaults (8.5/10.5pt for tech reports)
%%──────────────────────────────────────────────────────────────────

\lstset{
  basicstyle=\fontsize{8.5}{10.5}\selectfont\ttfamily,
  breaklines=true,
  breakatwhitespace=false,
  columns=flexible,
  keepspaces=true,
  frame=l,
  framerule=1.5pt,
  rulecolor=\color{skAccent!25},
  backgroundcolor=\color{skCodeBg},
  xleftmargin=10pt,
  xrightmargin=6pt,
  aboveskip=6pt,
  belowskip=6pt,
  numbers=none,
  showstringspaces=false,
  tabsize=4,
  postbreak=\mbox{\textcolor{skComment}{$\hookrightarrow$}\space},
  language=Rust,
}

%%──────────────────────────────────────────────────────────────────
%% Section headings (titlesec)
%%──────────────────────────────────────────────────────────────────

\RequirePackage{titlesec}

\titleformat{\section}
  {\large\bfseries\color{skAccent}\lsstyle}
  {\thesection}{0.7em}{}
  [\vspace{1pt}{\color{skAccent!30}\titlerule[0.4pt]}]
\titlespacing*{\section}{0pt}{2.0ex plus 0.6ex minus 0.2ex}{0.8ex plus 0.2ex}

\titleformat{\subsection}
  {\normalsize\bfseries\color{skAccent!85!black}}
  {\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.4ex plus 0.4ex minus 0.2ex}{0.4ex plus 0.1ex}

\titleformat{\subsubsection}
  {\small\bfseries\color{skAccent!70!black}}
  {\thesubsubsection}{0.5em}{}
\titlespacing*{\subsubsection}{0pt}{1.0ex plus 0.3ex minus 0.1ex}{0.3ex plus 0.1ex}

%%──────────────────────────────────────────────────────────────────
%% Table of Contents styling
%%──────────────────────────────────────────────────────────────────

\RequirePackage{titletoc}
\setcounter{tocdepth}{2}  % sections + subsections only
\titlecontents{section}[0em]
  {\addvspace{0.6em}\bfseries\color{skAccent}}
  {\thecontentslabel\hspace{0.8em}}{}
  {\hfill\contentspage}
\titlecontents{subsection}[1.8em]
  {\color{skAccent!70!black}}
  {\thecontentslabel\hspace{0.7em}}{}
  {\titlerule*[0.5em]{.}\contentspage}


%%──────────────────────────────────────────────────────────────────
%% Headers / footers (fancyhdr) — configured by \maketechreporttitle
%%──────────────────────────────────────────────────────────────────

\RequirePackage{fancyhdr}

% Internal storage for header fields
\newcommand{\sk@rptitle}{}
\newcommand{\sk@rpid}{}

% Default git metadata
\providecommand{\gitbranch}{unknown}
\providecommand{\githash}{unknown}
\providecommand{\gitdate}{\today}

% Load gitinfo.tex if generated by Makefile
\IfFileExists{gitinfo.tex}{\input{gitinfo.tex}}{}

\fancypagestyle{skreport}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\headrule}{\hbox to\headwidth{%
    \color{skAccent}\leaders\hrule height \headrulewidth\hfill}}%
  \fancyhead[L]{\small\color{skAccent!80!black}\sk@rptitle}%
  \fancyhead[R]{\small\color{skAccent!80!black}\sk@rpid}%
  \fancyfoot[C]{\small\thepage}%
}

%%──────────────────────────────────────────────────────────────────
%% Legacy Gen-2 callout colour aliases (point to sk-shared.def names)
%%──────────────────────────────────────────────────────────────────

\colorlet{notebg}{skNoteBg}
\colorlet{noteframe}{skNoteFrame}
\colorlet{warnbg}{skWarnBg}
\colorlet{warnframe}{skWarnFrame}
\colorlet{examplebg}{skExampleBg}
\colorlet{exampleframe}{skExampleFrame}

